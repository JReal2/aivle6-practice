{{>layouts/header}}
<style>
    a {
      color: inherit;
      text-decoration: none;
    }
</style>
<div class="container mt-4">
    <ul class="list-group">
        {{#newsPage.content}}
            <li class="list-group-item">
                <a href="/news/{{newsId}}"><h4 class="mb-2">제목 : {{title}}</h4></a>
                <small class="text-muted">News ID: {{newsId}}</small>
            </li>
        {{/newsPage.content}}
    </ul>
    <div class="mt-3 text-end">
        <a href="/news/create" class="btn btn-primary">Create News</a>
    </div>
    <ul class="pagination justify-content-center">
        <li class="page-item {{^hasPrev}}disabled{{/hasPrev}}">
            <a class="page-link" href="?page={{prev}}"
            tabindex="-1" aria-disabled="true">
            Previous
            </a>
        </li>
        {{#pageNumbers}}
            <li class="page-item {{#isCurrentPage}}active{{/isCurrentPage}}">
                <a class="page-link" href="?page={{number}}">{{number}}</a>
            </li>
        {{/pageNumbers}}
        <li class="page-item {{^hasNext}}disabled{{/hasNext}}">
            <a class="page-link" href="?page={{next}}"
            tabindex="-1" aria-disabled="true">
            Next
            </a>
        </li>
    </ul>
</div>
{{>layouts/footer}}
