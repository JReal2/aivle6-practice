### JupyterNotebooks ###
# gitignore template for Jupyter Notebooks
# website: http://jupyter.org/

.ipynb_checkpoints
*/.ipynb_checkpoints/*
.virtual_documents
__pycache__

# IPython
profile_default/
ipython_config.py

*.tmp.driveupload
*.ini
*.exe
*.pdf

# Deep Learning Result or Pretrained
*.pt
*.keras
*.npz
*.safetensors

# Large Volume Dataset
*.zip
*.jpg
*.txt
*.json
*.csv
*.xlsx
*.mp3
*.m4a

# sqlite3 database
*.db


# Remove previous ipynb_checkpoints
#   git rm -r .ipynb_checkpoints/

